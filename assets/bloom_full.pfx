pfx 1
# Full-screen bloom (no mask required — works without PGXP)
pass bright
  shader bloom_bright_full.glsl
  input u_tex source_down
  scale 0.5
  format rgba16f
  uniform u_thr 0.4
pass h1
  shader builtin:blur
  input u_tex previous
  scale 0.5
  format rgba16f
  uniform u_dir 1 0
pass v1
  shader builtin:blur
  input u_tex previous
  scale 0.5
  format rgba16f
  uniform u_dir 0 1
pass h2
  shader builtin:blur
  input u_tex previous
  scale 0.5
  format rgba16f
  uniform u_dir 2 0
pass v2
  shader builtin:blur
  input u_tex previous
  scale 0.5
  format rgba16f
  uniform u_dir 0 2
pass composite
  shader bloom_composite_full.glsl
  input u_bloom previous
  blend screen
  uniform u_strength 1.0
